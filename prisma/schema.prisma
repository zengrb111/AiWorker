generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  phone          String          @unique
  passwordHash   String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  wechatBindings WechatBinding[]
  conversations  Conversation[]
  contentItems   ContentItem[]
  openClawTasks  OpenClawTask[]
  knowledgeBases KnowledgeBase[]
}

model WechatBinding {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String    @default("PENDING")
  ticketId       String?   @unique
  qrCodeUrl      String?
  wechatNickname String?
  wechatOpenId   String?
  wechatNo       String?
  boundAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Conversation {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     Message[]
  contentItems ContentItem[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())
}

model ContentItem {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  body                 String
  category             String?
  coverImageUrl        String?
  videoUrl             String?
  inlineImagesJson     String?
  sourceConversationId String?
  sourceConversation   Conversation?  @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  publishRecords       PublishRecord[]
  createdAt            DateTime       @default(now())
}

model OpenClawTask {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  prompt     String
  status     String   @default("PENDING")
  resultJson String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// 发布记录（内容库条目 → 各发布渠道）
model PublishRecord {
  id             String      @id @default(cuid())
  contentItemId  String
  contentItem    ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  channel        String      // 发布渠道：官网好物推荐(hgwx) / 小红书 / 公众号 …
  remoteId       String?     // 渠道侧条目 id（如 hgwx 的 UUID）
  remoteUrl      String?     // 渠道侧访问地址
  title          String      // 发布时的标题快照
  publisher      String      // 发布人（账号手机号或系统标识）
  status         String      @default("SUCCESS") // SUCCESS | FAILED
  error          String?
  publishedAt    DateTime    @default(now())
  createdAt      DateTime    @default(now())
}

/// 平台授权账号（官网渠道免授权；小红书/头条号以创作者后台 Cookie 授权）
model PlatformAccount {
  id            String    @id @default(cuid())
  platform      String    // site | xhs | toutiao
  displayName   String    // 平台侧账号昵称 / 名称
  externalId    String?   // 平台侧用户/账号 ID
  credentialEnc String?   // AES-256-GCM 加密的凭据（Cookie）
  status        String    @default("active") // active | expired | error
  statusMsg     String?   // 最近一次校验/同步结果说明
  boundBy       String?   // 绑定人（账号手机号）
  lastSyncAt    DateTime?
  lastVerifyAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  metrics       PlatformContentMetric[]
  @@unique([platform, externalId])
}

/// 平台内容效果数据（按天、按内容；官网数据每日覆盖更新）
model PlatformContentMetric {
  id         String           @id @default(cuid())
  account    PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String?
  platform   String           // site | xhs | toutiao
  contentKey String           // 平台侧内容标识（官网 recommend id / 笔记 id / 文章 id）
  title      String
  category   String?
  metricDate String           // yyyy-MM-dd，数据所属日
  views      Int              @default(0)
  clicks     Int              @default(0)
  likes      Int              @default(0)
  comments   Int              @default(0)
  collects   Int              @default(0)
  shares     Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  @@unique([platform, contentKey, metricDate])
  @@index([platform, metricDate])
}

/// 平台站点级流量（按天 PV/UV）
model PlatformSiteMetric {
  id         String @id @default(cuid())
  platform   String // site | xhs | toutiao
  metricDate String // yyyy-MM-dd
  pv         Int    @default(0)
  uv         Int    @default(0)
  @@unique([platform, metricDate])
}

/// RAG 知识库
model KnowledgeBase {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String       @default("")
  vectorModel   String       @default("local-hash-256")
  chunkStrategy String       @default("semantic") // semantic | fixed
  chunkSize     Int          @default(600)
  chunkOverlap  Int          @default(80)
  visibility    String       @default("private") // private | team
  topK          Int          @default(5)
  status        String       @default("EMPTY") // EMPTY | READY | TRAINING
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  documents     KbDocument[]
  chunks        KbChunk[]
}

/// 知识库文档（文本 / 图片 / 图文）
model KbDocument {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  filename        String
  mimeType        String        @default("")
  kind            String        @default("text") // text | image | rich
  sizeBytes       Int           @default(0)
  storedPath      String        @default("")
  parseStatus     String        @default("PENDING") // PENDING | PARSED | EMPTY | FAILED
  parseNote       String        @default("")
  extractedText   String        @default("")
  chunkCount      Int           @default(0)
  createdAt       DateTime      @default(now())
  chunks          KbChunk[]
}

/// 知识库切片
model KbChunk {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  documentId      String
  document        KbDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  seq             Int
  content         String
  charCount       Int           @default(0)
  enabled         Boolean       @default(true)
  embedding       String? // JSON float array
  trainedAt       DateTime?
  createdAt       DateTime      @default(now())
}
