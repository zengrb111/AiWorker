    setNav('analytics');
    hideAllViews();
    renderAnalytics();
    document.getElementById('viewAnalytics').classList.remove('hidden');
    document.getElementById('crumb').textContent = '当前页面';
    document.getElementById('pageTitle').textContent = '效果分析';
    document.querySelector('.workspace-body').scrollTop = 0;
  }

  renderAnalytics();

  /* ---------- Toast ---------- */
  let toastTimer;
  function toast(msg){
    const t = document.getElementById('toast');
    document.getElementById('toastText').textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(()=>t.classList.remove('show'), 2000);
  }

  /* ---------- Embed 模式：主应用 iframe 引入时隐藏外壳并直达指定分区 ---------- */
  (function(){
    const raw = (location.hash || '').replace(/^#/, '') + '&' + (location.search || '').replace(/^\?/, '');
    const m = /embed[=:\/]([a-z]+)/i.exec(raw);
    if(!m) return;
    const sec = m[1];
    document.body.classList.add('embed');
    if(SEC_TITLE[sec]) switchSection(sec);
  })();
</script>
</body>
</html>
