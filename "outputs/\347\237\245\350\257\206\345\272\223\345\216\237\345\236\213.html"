      toast('无命中，试试下调相似度阈值');
      return;
    }

    cnt.textContent = hits.length + ' 条';
    cnt.className = 'chip blue';
    cnt.style.cssText = '';
    sum.classList.remove('hidden');
    const avg = hits.reduce((a, c) => a + c.score, 0) / hits.length;
    const kbs = [...new Set(hits.map(c => c.kb))];
    document.getElementById('resBig').textContent = '命中 ' + hits.length + ' 条';
    document.getElementById('resMs').innerHTML =
      `耗时 <b>${ms} ms</b> · 最高 <b>${hits[0].score.toFixed(2)}</b> · 平均 <b>${avg.toFixed(2)}</b>` +
