  function runSearch(){
    const q = document.getElementById('qInput').value.trim();
    if(!q){ toast('请先输入问题'); return; }
    const topK = +document.getElementById('rngK').value;
    const thr  = +document.getElementById('rngT').value / 100;
    const scope = document.getElementById('scopeSel').value;
    let hits = CHUNK_POOL.filter(c => c.score >= thr);
    if(scope !== 'all') hits = hits.filter(c => c.kb === scope);
    hits = hits.slice(0, topK);
    const ms = 40 + Math.round(Math.random() * 70) + hits.length * 8;

    document.getElementById('resSub').textContent = '问题：' + (q.length > 24 ? q.slice(0, 24) + '…' : q);
    const cnt = document.getElementById('resCount');
    const sum = document.getElementById('resSum');
    const list = document.getElementById('resList');

    if(!hits.length){
      cnt.textContent = '0 条';
      cnt.className = 'chip';
      cnt.style.cssText = 'background:var(--danger-bg);border-color:#f0cfcd;color:var(--danger);';
      sum.classList.add('hidden');
      list.innerHTML = `<div class="empty">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg></div>
