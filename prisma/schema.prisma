generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  phone          String          @unique
  passwordHash   String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  wechatBindings WechatBinding[]
  conversations  Conversation[]
  contentItems   ContentItem[]
  openClawTasks  OpenClawTask[]
  knowledgeBases KnowledgeBase[]
  platformAccounts       PlatformAccount[]
  platformSiteMetrics    PlatformSiteMetric[]
  platformContentMetrics PlatformContentMetric[]
  scheduledJobs          ScheduledJob[]
}

/// 平台自持的定时任务（替代网关上跨用户共享的 cron）。
/// 到点由 AiWorker 调度器在该用户的专属会话里执行 prompt，网关不再保存用户任务数据。
model ScheduledJob {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  enabled    Boolean   @default(true)
  /// 标准 5 段 cron：分 时 日 月 周（支持通配、单值、逗号列表、区间、步进 /n）
  cronExpr   String
  timezone   String    @default("Asia/Shanghai")
  /// 到点在「该用户专属会话」里执行的指令（原网关任务 payload.message）
  prompt     String
  /// 迁移溯源：原网关任务 id（可空）
  gatewayJobId String? @unique
  lastRunAt  DateTime?
  /// SUCCEEDED | FAILED | RUNNING
  lastStatus String?
  lastError  String?
  lastResult String?
  runCount   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([enabled])
}

model WechatBinding {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String    @default("PENDING")
  ticketId       String?   @unique
  qrCodeUrl      String?
  wechatNickname String?
  wechatOpenId   String?
  wechatNo       String?
  boundAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Conversation {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     Message[]
  contentItems ContentItem[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())
}

model ContentItem {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  body                 String
  category             String?
  coverImageUrl        String?
  videoUrl             String?
  inlineImagesJson     String?
  sourceConversationId String?
  sourceConversation   Conversation?  @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  publishRecords       PublishRecord[]
  createdAt            DateTime       @default(now())
}

model OpenClawTask {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  prompt     String
  status     String   @default("PENDING")
  resultJson String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// 发布记录（内容库条目 → 各发布渠道）
model PublishRecord {
  id             String      @id @default(cuid())
  contentItemId  String
  contentItem    ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  channel        String      // 发布渠道：官网好物推荐(hgwx) / 小红书 / 公众号 …
  remoteId       String?     // 渠道侧条目 id（如 hgwx 的 UUID）
  remoteUrl      String?     // 渠道侧访问地址
  title          String      // 发布时的标题快照
  publisher      String      // 发布人（账号手机号或系统标识）
  status         String      @default("SUCCESS") // SUCCESS | FAILED
  error          String?
  publishedAt    DateTime    @default(now())
  createdAt      DateTime    @default(now())
}

/// 平台授权账号（按登录用户隔离；官网/小红书/头条号各自授权，凭据加密存储）
model PlatformAccount {
  id            String    @id @default(cuid())
  userId        String    // 归属登录用户
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform      String    // site | xhs | toutiao
  displayName   String    // 平台侧账号昵称 / 名称（官网为域名）
  externalId    String?   // 平台侧用户/账号 ID（官网为 null）
  credentialEnc String?   // AES-256-GCM 加密的凭据（小红书/头条号=Cookie；官网={domain,token} JSON）
  status        String    @default("active") // active | expired | error
  statusMsg     String?   // 最近一次校验/同步结果说明
  boundBy       String?   // 绑定人（账号手机号，便于展示）
  lastSyncAt    DateTime?
  lastVerifyAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  metrics       PlatformContentMetric[]
  @@unique([userId, platform])
}

/// 平台内容效果数据（按天、按内容；按登录用户隔离）
model PlatformContentMetric {
  id         String           @id @default(cuid())
  userId     String           // 归属登录用户（解绑账号时仍保留，避免效果数据丢失）
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    PlatformAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String?
  platform   String           // site | xhs | toutiao | wechat
  contentKey String           // 平台侧内容标识（官网 recommend id / 笔记 id / 文章 id）
  title      String
  category   String?
  metricDate String           // yyyy-MM-dd，数据所属日
  views       Int              @default(0)
  impressions Int              @default(0) // 展现量（头条号 showCount）；小红书/官网平台不提供时为 0
  clicks      Int              @default(0) // 点击量（仅官网有真实统计；小红书/头条号平台不提供）
  likes       Int              @default(0)
  comments    Int              @default(0)
  collects    Int              @default(0)
  shares      Int              @default(0)
  readers     Int              @default(0) // 阅读人数（公众号「送达阅读人数」；其他平台不提供为 0）
  wows        Int              @default(0) // 在看数（公众号；其他平台不提供为 0）
  visible     Boolean          @default(true) // 该内容当前是否仍公开可见（同步时不在公开列表里的会被移除）
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@unique([userId, platform, contentKey, metricDate])
  @@index([platform, metricDate])
}

/// 内容原文（爆款拆解必须基于真实原文，不做通用推断）
/// 采集时抓取图文内容的正文存这里；视频等无文字内容不写记录。
model ContentSource {
  id         String   @id @default(cuid())
  platform   String // site | xhs | toutiao
  contentKey String // 与 PlatformContentMetric.contentKey 对应
  title      String
  body       String // 正文全文（含话题标签）
  topics     String? // 话题标签，逗号分隔
  author     String?
  source     String   @default("collector") // collector(CDP) | feed | content-item
  fetchedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([platform, contentKey])
  @@index([platform])
}

/// 爆款内容拆解（效果分析触发，AI 拆解 + 人工二次编辑，供每日内容生产任务参考）
model ContentBreakdown {
  id            String   @id @default(cuid())
  platform      String   // site | xhs | toutiao
  contentKey    String   // 平台侧内容标识（与 PlatformContentMetric.contentKey 对应）
  title         String
  category      String?
  metricViews   Int      @default(0) // 拆解时的阅读/播放量（爆款上下文）
  aiBreakdown   String   // AI 生成的结构化拆解（Markdown）
  editedBreakdown String? // 人工二次编辑后的版本（null 表示未编辑）
  status        String   @default("draft") // draft | edited | active
  usedByCron    Boolean  @default(false)   // 是否已纳入每日任务参考文件
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([platform, contentKey])
  @@index([status])
}

/// 平台站点级流量（按天 PV/UV，按登录用户隔离）
model PlatformSiteMetric {
  id         String @id @default(cuid())
  userId     String // 归属登录用户
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String // site | xhs | toutiao | wechat | channels
  metricDate String // yyyy-MM-dd
  pv         Int    @default(0)
  uv         Int    @default(0)
  fans       Int    @default(0) // 当日新增关注（公众号涨粉；其他平台为 0）
  /// 账号级互动汇总（公众号等后台只提供账号级汇总、不提供内容级明细时使用）
  reads      Int    @default(0) // 阅读次数（公众号）
  shares     Int    @default(0) // 分享次数
  likes      Int    @default(0) // 点赞次数
  wows       Int    @default(0) // 在看次数
  @@unique([userId, platform, metricDate])
}

/// RAG 知识库
model KnowledgeBase {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String       @default("")
  vectorModel   String       @default("local-hash-256")
  chunkStrategy String       @default("semantic") // semantic | fixed
  chunkSize     Int          @default(600)
  chunkOverlap  Int          @default(80)
  visibility    String       @default("private") // private | team
  topK          Int          @default(5)
  status        String       @default("EMPTY") // EMPTY | READY | TRAINING
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  documents     KbDocument[]
  chunks        KbChunk[]
}

/// 知识库文档（文本 / 图片 / 图文）
model KbDocument {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  filename        String
  mimeType        String        @default("")
  kind            String        @default("text") // text | image | rich
  sizeBytes       Int           @default(0)
  storedPath      String        @default("")
  parseStatus     String        @default("PENDING") // PENDING | PARSED | EMPTY | FAILED
  parseNote       String        @default("")
  extractedText   String        @default("")
  chunkCount      Int           @default(0)
  createdAt       DateTime      @default(now())
  chunks          KbChunk[]
}

/// 知识库切片
model KbChunk {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  documentId      String
  document        KbDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  seq             Int
  content         String
  charCount       Int           @default(0)
  enabled         Boolean       @default(true)
  embedding       String? // JSON float array
  trainedAt       DateTime?
  createdAt       DateTime      @default(now())
}
