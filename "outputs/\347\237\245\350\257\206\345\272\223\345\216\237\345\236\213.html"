<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>创星云 · 知识库原型</title>
<style>
  :root{
    --bg:#eef3f7; --bg-page:#eaf3ff; --bg-page-2:#f4f8ff;
    --panel:#ffffff; --panel-soft:#f6f9fc;
    --ink:#151a24; --muted:#687482; --muted-2:#8c9aa9;
    --line:#d9e3ec; --line-soft:#e6eef5;
    --accent:#2b7cff; --accent-dark:#155bd4; --accent-cyan:#17d5ff;
    --success:#16a34a; --success-bg:#e7f6ec;
    --warning:#9a6816; --warning-bg:#fdf4e3;
    --danger:#b0443e; --danger-bg:#fbeeed;
    --shadow:0 24px 70px rgba(21,32,54,.18);
    --sidebar-width:256px;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;height:100vh;overflow:hidden;color:var(--ink);
    font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif;
    background:
      radial-gradient(circle at 18% 6%, rgba(120,188,255,.22), transparent 36%),
      radial-gradient(circle at 92% 8%, rgba(180,220,255,.28), transparent 40%),
      linear-gradient(180deg,var(--bg-page) 0%,var(--bg-page-2) 60%,var(--bg) 100%);
    background-attachment:fixed;
  }
  button,input,textarea,select{font:inherit;}
  button{border:0;cursor:pointer;background:none;color:inherit;}
  h1,h2,h3,p{margin:0;}
  .hidden{display:none !important;}

  /* ============ Shell ============ */
  .app-shell{display:grid;height:100vh;overflow:hidden;grid-template-columns:var(--sidebar-width) 1fr;}

  /* ============ Sidebar ============ */
  .sidebar{display:grid;grid-template-rows:auto 1fr auto;gap:18px;padding:22px 14px;}
  .sidebar-brand{display:flex;align-items:center;gap:12px;padding:6px 10px 4px;}
  .brand-avatar{display:grid;width:40px;height:40px;place-items:center;border-radius:12px;
    background:linear-gradient(135deg,#4f9bff,#1d4ed8);color:#fff;font-weight:900;font-size:16px;
    box-shadow:0 8px 20px rgba(43,124,255,.28);letter-spacing:.5px;}
  .brand-text{display:grid;gap:2px;}
  .brand-title{font-size:16px;font-weight:800;}
  .brand-sub{font-size:12px;color:var(--muted-2);}
  .sidebar nav{display:grid;align-content:start;gap:6px;padding:4px 0;}
  .sidebar nav button{display:flex;align-items:center;gap:12px;text-align:left;min-height:40px;
    padding:0 14px;font-weight:700;border-radius:12px;color:var(--ink);transition:.15s;}
  .nav-icon{display:inline-grid;width:18px;place-items:center;}
  .nav-icon svg{width:17px;height:17px;display:block;}
  .sidebar nav button:hover{background:rgba(43,124,255,.08);color:var(--accent-dark);}
  .sidebar nav button.active{background:var(--accent);color:#fff;box-shadow:0 8px 18px rgba(43,124,255,.28);}
  .sidebar-foot{padding:0 6px;display:grid;gap:10px;}
  .storage-box{border:1px solid var(--line);border-radius:12px;padding:12px;background:var(--panel);}
  .storage-box .row{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);font-weight:700;margin-bottom:8px;}
  .bar{height:6px;border-radius:99px;background:var(--line-soft);overflow:hidden;}
  .bar>i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--accent),var(--accent-cyan));}
  .storage-box .tip{font-size:11px;color:var(--muted-2);margin-top:8px;}

  /* ============ Workspace ============ */
  .workspace{display:grid;grid-template-rows:auto 1fr;gap:18px;min-width:0;min-height:0;height:100%;overflow:hidden;padding:22px 24px 24px;}
  .workspace-header{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding:8px 4px 0;}
  .crumb{color:var(--accent);font-size:13px;font-weight:800;}
  .workspace-header h2{margin:0;font-size:30px;font-weight:800;letter-spacing:.5px;}
  .user-chip{display:inline-flex;align-items:center;gap:14px;border:1px solid var(--line);border-radius:12px;
    padding:8px 12px 8px 16px;background:var(--panel);font-weight:700;box-shadow:0 6px 18px rgba(31,64,109,.06);}
  .user-chip .exit{border-radius:8px;padding:4px 12px;background:var(--panel-soft);color:var(--accent-dark);font-size:13px;font-weight:800;}
  .workspace-body{min-height:0;overflow-y:auto;padding:2px 4px 24px;}

  /* ============ Buttons ============ */
  .btn{display:inline-flex;align-items:center;gap:8px;border-radius:10px;padding:9px 16px;font-size:13px;font-weight:800;transition:.15s;}
  .btn-primary{background:var(--accent);color:#fff;box-shadow:0 8px 18px rgba(43,124,255,.28);}
  .btn-primary:hover{background:var(--accent-dark);}
  .btn-ghost{background:var(--panel);border:1px solid var(--line);color:var(--muted);}
  .btn-ghost:hover{color:var(--accent-dark);border-color:var(--accent);}
  .btn-danger{background:var(--danger-bg);color:var(--danger);}
  .btn-danger:hover{background:#f6dedc;}
  .btn-soft{background:var(--panel-soft);color:var(--accent-dark);border:1px solid var(--line);}
  .btn[disabled]{opacity:.55;cursor:not-allowed;box-shadow:none;}
  .btn svg{width:15px;height:15px;}

  /* ============ Toolbar ============ */
  .toolbar{display:flex;align-items:center;gap:12px;margin:2px 0 18px;}
  .search{flex:1;max-width:380px;position:relative;}
  .search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--muted-2);}
  .search input{width:100%;height:42px;border:1px solid var(--line);border-radius:12px;background:var(--panel);
    padding:0 14px 0 36px;font-size:13px;color:var(--ink);outline:none;box-shadow:0 4px 14px rgba(31,64,109,.05);}
  .search input:focus{border-color:var(--accent);}
  .toolbar .spacer{flex:1;}
  .seg{display:inline-flex;background:var(--panel);border:1px solid var(--line);border-radius:11px;padding:3px;gap:2px;}
  .seg button{padding:6px 12px;border-radius:9px;font-size:12px;font-weight:800;color:var(--muted);}
  .seg button.on{background:var(--accent);color:#fff;}

  /* ============ Stat cards ============ */
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px;}
  .stat{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px 18px;
    box-shadow:0 6px 18px rgba(31,64,109,.05);}
  .stat .k{font-size:12px;color:var(--muted);font-weight:800;}
  .stat .v{font-size:26px;font-weight:900;margin-top:6px;letter-spacing:.5px;}
  .stat .v small{font-size:13px;color:var(--muted-2);font-weight:700;margin-left:4px;}

  /* ============ KB grid ============ */
  .kb-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;}
  .kb-card{position:relative;background:var(--panel);border:1px solid var(--line);border-radius:16px;
    padding:18px;cursor:pointer;transition:.16s;box-shadow:0 6px 18px rgba(31,64,109,.05);}
  .kb-card:hover{transform:translateY(-2px);border-color:rgba(43,124,255,.5);box-shadow:0 16px 34px rgba(31,64,109,.13);}
  .kb-card-top{display:flex;align-items:flex-start;gap:12px;}
  .kb-ico{display:grid;width:44px;height:44px;place-items:center;border-radius:13px;flex:0 0 auto;color:#fff;
    background:linear-gradient(135deg,#4f9bff,#1d4ed8);box-shadow:0 8px 18px rgba(43,124,255,.26);}
  .kb-ico.alt{background:linear-gradient(135deg,#22d3ee,#0ea5e9);box-shadow:0 8px 18px rgba(14,165,233,.26);}
  .kb-ico.alt2{background:linear-gradient(135deg,#7c8cff,#5b3df5);box-shadow:0 8px 18px rgba(91,61,245,.24);}
  .kb-ico svg{width:22px;height:22px;}
  .kb-name{font-size:16px;font-weight:900;line-height:1.3;}
  .kb-desc{font-size:12.5px;color:var(--muted);margin-top:5px;line-height:1.55;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:38px;}
  .kb-actions{position:absolute;top:14px;right:14px;display:flex;gap:6px;opacity:0;transition:.15s;}
  .kb-card:hover .kb-actions{opacity:1;}
  .icon-btn{display:grid;width:30px;height:30px;place-items:center;border-radius:9px;background:var(--panel-soft);
    border:1px solid var(--line);color:var(--muted);}
  .icon-btn:hover{color:var(--accent-dark);border-color:var(--accent);background:#fff;}
  .icon-btn.danger:hover{color:var(--danger);border-color:var(--danger);}
  .icon-btn svg{width:15px;height:15px;}
  .chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px;}
  .chip{font-size:11px;font-weight:800;padding:4px 9px;border-radius:99px;background:var(--panel-soft);
    border:1px solid var(--line);color:var(--muted);}
  .chip.blue{background:#eaf3ff;border-color:#cfe2ff;color:var(--accent-dark);}
  .chip.cyan{background:#e6fbff;border-color:#c6f1fb;color:#0e7490;}
  .kb-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:14px;
    padding-top:13px;border-top:1px solid var(--line-soft);}
  .kb-meta{font-size:12px;color:var(--muted);font-weight:700;}
  .pill{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:900;padding:4px 10px;border-radius:99px;}
  .pill::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor;}
  .pill.ok{background:var(--success-bg);color:var(--success);}
  .pill.warn{background:var(--warning-bg);color:var(--warning);}
  .pill.run{background:#eaf3ff;color:var(--accent-dark);}
  .pill.run::before{animation:blink 1s infinite;}
  @keyframes blink{50%{opacity:.25;}}

  /* ============ Detail ============ */
  .back-btn{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:800;color:var(--muted);
    padding:6px 12px;border-radius:10px;border:1px solid var(--line);background:var(--panel);margin-bottom:16px;}
  .back-btn:hover{color:var(--accent-dark);border-color:var(--accent);}
  .detail-head{display:flex;align-items:flex-start;gap:14px;margin-bottom:20px;flex-wrap:wrap;}
  .detail-head .kb-ico{width:52px;height:52px;border-radius:15px;}
  .detail-title{font-size:22px;font-weight:900;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
  .detail-sub{font-size:12.5px;color:var(--muted);margin-top:6px;line-height:1.6;max-width:720px;}
  .detail-head .right{margin-left:auto;display:flex;gap:10px;align-items:center;flex-wrap:wrap;}

  /* Stepper */
  .steps{display:flex;align-items:center;gap:0;background:var(--panel);border:1px solid var(--line);
    border-radius:16px;padding:16px 22px;margin-bottom:18px;box-shadow:0 6px 18px rgba(31,64,109,.05);}
  .step{display:flex;align-items:center;gap:11px;cursor:pointer;}
  .step .no{display:grid;width:32px;height:32px;place-items:center;border-radius:50%;font-size:13px;font-weight:900;
    background:var(--panel-soft);color:var(--muted);border:1.5px solid var(--line);transition:.15s;flex:0 0 auto;}
  .step .t{display:grid;gap:2px;}
  .step .t b{font-size:13.5px;font-weight:900;color:var(--muted);}
  .step .t span{font-size:11px;color:var(--muted-2);}
  .step.active .no{background:var(--accent);border-color:var(--accent);color:#fff;box-shadow:0 6px 14px rgba(43,124,255,.3);}
  .step.active .t b{color:var(--ink);}
  .step.done .no{background:var(--success-bg);border-color:#bfe6cc;color:var(--success);}
  .step.done .t b{color:var(--ink);}
  .step-line{flex:1;height:2px;background:var(--line);margin:0 16px;border-radius:2px;position:relative;overflow:hidden;}
  .step-line>i{position:absolute;inset:0;width:0;background:linear-gradient(90deg,var(--accent),var(--accent-cyan));transition:width .35s;}

  /* Panels */
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:20px;
    box-shadow:0 6px 18px rgba(31,64,109,.05);}
  .panel + .panel{margin-top:16px;}
  .panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;}
  .panel-head h3{font-size:15px;font-weight:900;}
  .panel-head p{font-size:12px;color:var(--muted);margin-top:4px;}

  .dropzone{border:1.6px dashed var(--line);border-radius:14px;background:var(--panel-soft);
    padding:34px 20px;text-align:center;transition:.15s;cursor:pointer;}
  .dropzone:hover,.dropzone.over{border-color:var(--accent);background:#eef5ff;}
  .dropzone .up{display:grid;width:54px;height:54px;place-items:center;margin:0 auto 12px;border-radius:16px;
    background:#eaf3ff;color:var(--accent);}
  .dropzone .up svg{width:26px;height:26px;}
  .dropzone h4{font-size:14.5px;font-weight:900;}
  .dropzone p{font-size:12px;color:var(--muted);margin-top:6px;}
  .types{display:flex;justify-content:center;flex-wrap:wrap;gap:7px;margin-top:14px;}
  .type-chip{font-size:11px;font-weight:800;padding:4px 10px;border-radius:8px;background:#fff;border:1px solid var(--line);color:var(--muted);}
  .type-chip b{color:var(--accent-dark);}

  .file-list{margin-top:16px;display:grid;gap:10px;}
  .file-row{display:flex;align-items:center;gap:13px;border:1px solid var(--line);border-radius:13px;padding:12px 14px;background:#fff;}
  .file-ico{display:grid;width:38px;height:38px;place-items:center;border-radius:11px;flex:0 0 auto;font-size:11px;font-weight:900;color:#fff;}
  .file-ico.txt{background:linear-gradient(135deg,#4f9bff,#1d4ed8);}
  .file-ico.img{background:linear-gradient(135deg,#22d3ee,#0ea5e9);}
  .file-ico.mix{background:linear-gradient(135deg,#7c8cff,#5b3df5);}
  .file-ico svg{width:18px;height:18px;}
  .file-main{flex:1;min-width:0;}
  .file-main .n{font-size:13px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .file-main .m{font-size:11.5px;color:var(--muted);margin-top:3px;}
  .file-main .bar{margin-top:7px;max-width:220px;}
  .file-pct{font-size:11.5px;font-weight:800;color:var(--accent-dark);min-width:38px;text-align:right;}

  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  .field{display:grid;gap:7px;}
  .field.full{grid-column:1/-1;}
  .field label{font-size:12.5px;font-weight:800;color:var(--ink);}
  .field label span{color:var(--muted-2);font-weight:700;}
  .field input,.field select,.field textarea{height:42px;border:1px solid var(--line);border-radius:11px;background:#fff;
    padding:0 13px;font-size:13px;color:var(--ink);outline:none;}
  .field textarea{height:84px;padding:11px 13px;resize:vertical;line-height:1.6;}
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--accent);}
  .field .hint{font-size:11px;color:var(--muted-2);}
  .radio-row{display:flex;gap:10px;flex-wrap:wrap;}
  .radio{flex:1;min-width:130px;border:1.4px solid var(--line);border-radius:12px;padding:12px;cursor:pointer;background:#fff;transition:.15s;}
  .radio:hover{border-color:#bcd6ff;}
  .radio.on{border-color:var(--accent);background:#eef5ff;box-shadow:0 0 0 3px rgba(43,124,255,.1);}
  .radio b{font-size:13px;font-weight:900;display:block;}
  .radio span{font-size:11px;color:var(--muted);display:block;margin-top:4px;line-height:1.5;}
  .slider-row{display:flex;align-items:center;gap:14px;}
  input[type=range]{flex:1;accent-color:var(--accent);height:4px;}
  .slider-val{font-size:13px;font-weight:900;color:var(--accent-dark);min-width:64px;text-align:right;}

  .chunk-wrap{display:grid;grid-template-columns:minmax(280px,340px) 1fr;gap:16px;align-items:start;}
  .chunk-list{display:grid;gap:10px;max-height:560px;overflow-y:auto;padding-right:4px;}
  .chunk{border:1px solid var(--line);border-radius:13px;padding:13px 14px;background:#fff;}
  .chunk.off{opacity:.5;}
  .chunk-top{display:flex;align-items:center;gap:9px;margin-bottom:8px;}
  .chunk-no{font-size:11px;font-weight:900;padding:3px 9px;border-radius:99px;background:#eaf3ff;color:var(--accent-dark);}
  .chunk-len{font-size:11px;color:var(--muted-2);font-weight:800;}
  .chunk-top .sw{margin-left:auto;}
  .chunk p{font-size:12.5px;color:var(--muted);line-height:1.65;}
  .sw{position:relative;width:38px;height:21px;border-radius:99px;background:var(--line);transition:.16s;flex:0 0 auto;}
  .sw::after{content:"";position:absolute;top:2px;left:2px;width:17px;height:17px;border-radius:50%;background:#fff;transition:.16s;box-shadow:0 1px 3px rgba(0,0,0,.2);}
  .sw.on{background:var(--accent);}
  .sw.on::after{left:19px;}

  .train-state{display:grid;gap:16px;}
  .progress-big{height:10px;border-radius:99px;background:var(--line-soft);overflow:hidden;}
  .progress-big>i{display:block;height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--accent),var(--accent-cyan));transition:width .4s;}
  .train-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
  .train-stat{background:var(--panel-soft);border:1px solid var(--line-soft);border-radius:12px;padding:13px;}
  .train-stat .k{font-size:11.5px;color:var(--muted);font-weight:800;}
  .train-stat .v{font-size:19px;font-weight:900;margin-top:5px;}
  .log{background:#0f1a2b;border-radius:13px;padding:14px 16px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
    font-size:12px;line-height:1.85;color:#a9c4e8;max-height:220px;overflow-y:auto;}
  .log .ok{color:#4ade80;}
  .log .in{color:#7dd3fc;}

  .step-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:18px;}
  .step-foot .left{font-size:12px;color:var(--muted);font-weight:700;}

  /* ============ Modal ============ */
  .backdrop{position:fixed;inset:0;background:rgba(15,26,43,.42);backdrop-filter:blur(3px);display:grid;place-items:center;z-index:60;padding:24px;}
  .modal{width:min(620px,100%);background:#fff;border-radius:18px;box-shadow:var(--shadow);overflow:hidden;animation:pop .18s ease-out;}
  @keyframes pop{from{transform:translateY(10px) scale(.98);opacity:0;}}
  .modal-head{display:flex;align-items:center;justify-content:space-between;padding:20px 22px 0;}
  .modal-head h3{font-size:17px;font-weight:900;}
  .modal-head .x{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;color:var(--muted);background:var(--panel-soft);}
  .modal-head .x:hover{color:var(--danger);}
  .modal-body{padding:18px 22px;}
  .modal-foot{display:flex;justify-content:flex-end;gap:10px;padding:16px 22px 20px;background:var(--panel-soft);border-top:1px solid var(--line-soft);}
  .modal.sm{width:min(400px,100%);text-align:center;}
  .modal.sm .modal-body{padding:26px 24px 18px;}
  .warn-ico{display:grid;width:52px;height:52px;place-items:center;margin:0 auto 14px;border-radius:50%;background:var(--danger-bg);color:var(--danger);font-size:24px;font-weight:900;}

  /* Toast */
  .toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%) translateY(20px);opacity:0;pointer-events:none;
    background:#0f1a2b;color:#fff;padding:12px 20px;border-radius:12px;font-size:13px;font-weight:800;
    box-shadow:var(--shadow);transition:.25s;z-index:80;display:flex;align-items:center;gap:9px;}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
  .toast .dot{width:7px;height:7px;border-radius:50%;background:#4ade80;}

  /* ============ 检索测试 ============ */
  .search-layout{display:grid;grid-template-columns:minmax(300px,352px) 1fr;gap:16px;align-items:start;}
  .query-box{display:grid;gap:14px;}
  .query-ta{width:100%;min-height:94px;border:1px solid var(--line);border-radius:12px;background:#fff;
    padding:12px 13px;font-size:13.5px;line-height:1.65;resize:vertical;outline:none;color:var(--ink);}
  .query-ta:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(43,124,255,.1);}
  .q-examples{display:flex;flex-wrap:wrap;gap:7px;}
  .q-ex{font-size:11.5px;font-weight:800;padding:5px 10px;border-radius:8px;background:var(--panel-soft);
    border:1px solid var(--line);color:var(--muted);cursor:pointer;transition:.15s;}
  .q-ex:hover{color:var(--accent-dark);border-color:var(--accent);background:#fff;}
  .check{display:flex;align-items:center;gap:10px;font-size:12.5px;font-weight:800;cursor:pointer;color:var(--ink);}
  .result-sum{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px;
    padding:12px 15px;background:var(--panel-soft);border:1px solid var(--line-soft);border-radius:12px;}
  .result-sum .big{font-size:14.5px;font-weight:900;}
  .result-sum .ms{font-size:12px;color:var(--muted);font-weight:700;}
  .result-sum .ms b{color:var(--accent-dark);}
  .res-card{border:1px solid var(--line);border-radius:14px;padding:15px 16px;background:#fff;
    margin-bottom:11px;transition:.15s;}
  .res-card:hover{border-color:rgba(43,124,255,.45);box-shadow:0 10px 26px rgba(31,64,109,.09);}
  .res-card.faded{opacity:.62;}
  .res-top{display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap;}
  .rank{display:grid;width:25px;height:25px;place-items:center;border-radius:8px;font-size:11.5px;font-weight:900;
    background:#eaf3ff;color:var(--accent-dark);flex:0 0 auto;}
  .rank.top{background:var(--accent);color:#fff;box-shadow:0 4px 10px rgba(43,124,255,.3);}
  .src{font-size:12.5px;font-weight:800;display:inline-flex;align-items:center;gap:7px;min-width:0;}
  .src .loc{color:var(--muted);font-weight:700;}
  .kb-tag{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:900;flex:0 0 auto;
    padding:4px 10px;border-radius:99px;background:#eef5ff;color:var(--accent-dark);border:1px solid #cfe2ff;}
  .kb-tag::before{content:"";width:6px;height:6px;border-radius:50%;
    background:linear-gradient(135deg,var(--accent),var(--accent-cyan));}
  .res-top .grow{flex:1;min-width:12px;}
  .score-wrap{display:flex;align-items:center;gap:9px;width:168px;flex:0 0 auto;}
  .score-bar{flex:1;height:6px;border-radius:99px;background:var(--line-soft);overflow:hidden;}
  .score-bar>i{display:block;height:100%;width:0;border-radius:99px;
    background:linear-gradient(90deg,var(--accent),var(--accent-cyan));transition:width .55s cubic-bezier(.2,.8,.3,1);}
  .score-val{font-size:12.5px;font-weight:900;color:var(--accent-dark);width:44px;text-align:right;
    font-variant-numeric:tabular-nums;}
  .res-body{font-size:13px;color:#2c3746;line-height:1.78;}
  .hl{background:#fff3bf;border-radius:4px;padding:0 2px;font-weight:800;color:#8a5a00;box-shadow:inset 0 -2px 0 #ffe08a;}
  .res-foot{display:flex;align-items:center;gap:10px;margin-top:12px;padding-top:10px;border-top:1px solid var(--line-soft);}
  .res-foot .tags{display:flex;gap:6px;flex-wrap:wrap;flex:1;}
  .empty{display:grid;place-items:center;gap:13px;padding:60px 20px;text-align:center;color:var(--muted);}
  .empty .ic{display:grid;width:62px;height:62px;place-items:center;border-radius:18px;background:var(--panel-soft);color:var(--muted-2);}
  .empty .ic svg{width:28px;height:28px;}

  /* ============ 账号管理 ============ */
  .acct-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(318px,1fr));gap:16px;}
  .acct-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:18px;
    box-shadow:0 6px 18px rgba(31,64,109,.05);transition:.15s;}
  .acct-card:hover{transform:translateY(-2px);border-color:rgba(43,124,255,.42);box-shadow:0 16px 32px rgba(31,64,109,.12);}
  .acct-card.off{background:linear-gradient(180deg,#fcfdff,#f5f8fc);border-style:dashed;}
  .acct-top{display:flex;align-items:center;gap:12px;}
  .plat-ico{display:grid;width:42px;height:42px;place-items:center;border-radius:13px;flex:0 0 auto;
    color:#fff;font-weight:900;font-size:15px;box-shadow:0 6px 14px rgba(31,64,109,.16);}
  .plat-site{background:linear-gradient(135deg,#4d94ff,#155bd4);}
  .plat-xhs{background:linear-gradient(135deg,#ff4d67,#d9163a);}
  .plat-toutiao{background:linear-gradient(135deg,#ff5f5f,#d92b2b);}
  .acct-plat{font-size:15px;font-weight:900;}
  .acct-uid{font-size:12px;color:var(--muted);margin-top:3px;word-break:break-all;}
  .acct-top .pill{margin-left:auto;flex:0 0 auto;}
  .acct-rows{display:grid;gap:9px;margin-top:15px;padding-top:14px;border-top:1px solid var(--line-soft);}
  .acct-rows .r{display:flex;align-items:center;justify-content:space-between;font-size:12.5px;gap:10px;}
  .acct-rows .r span{color:var(--muted);font-weight:700;}
  .acct-rows .r b{font-weight:800;text-align:right;}
  .acct-foot{display:flex;gap:10px;margin-top:16px;}
  .acct-foot .btn{flex:1;justify-content:center;}

  /* ============ 系统配置 ============ */
  .tabs{display:inline-flex;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:4px;gap:3px;margin-bottom:16px;}
  .tabs button{padding:8px 16px;border-radius:9px;font-size:13px;font-weight:800;color:var(--muted);transition:.15s;}
  .tabs button:hover{color:var(--accent-dark);}
  .tabs button.on{background:var(--accent);color:#fff;box-shadow:0 6px 14px rgba(43,124,255,.26);}
  .svc-list{display:grid;gap:11px;}
  .svc-card{display:flex;align-items:center;gap:16px;flex-wrap:wrap;border:1px solid var(--line);
    border-radius:14px;padding:15px 16px;background:#fff;}
  .svc-card.off{border-style:dashed;background:linear-gradient(180deg,#fcfdff,#f5f8fc);}
  .svc-ico{display:grid;width:42px;height:42px;place-items:center;border-radius:12px;color:#fff;font-weight:900;
    font-size:13px;flex:0 0 auto;background:linear-gradient(135deg,#4f9bff,#1d4ed8);box-shadow:0 6px 14px rgba(43,124,255,.24);}
  .svc-ico.g{background:linear-gradient(135deg,#34d399,#059669);box-shadow:0 6px 14px rgba(5,150,105,.22);}
  .svc-ico.p{background:linear-gradient(135deg,#a78bfa,#6d28d9);box-shadow:0 6px 14px rgba(109,40,217,.22);}
  .svc-ico.o{background:linear-gradient(135deg,#fbbf24,#d97706);box-shadow:0 6px 14px rgba(217,119,6,.22);}
  .svc-info{flex:1;min-width:190px;}
  .svc-name{font-size:14px;font-weight:900;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  .svc-meta{font-size:12px;color:var(--muted);margin-top:4px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;}
  .svc-key{display:flex;align-items:center;gap:8px;flex:0 0 auto;}
  .svc-key .kl{font-size:11.5px;color:var(--muted-2);font-weight:800;}
  .svc-key code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;background:var(--panel-soft);
    border:1px solid var(--line);border-radius:8px;padding:6px 10px;color:var(--ink);}
  .svc-actions{display:flex;gap:8px;flex:0 0 auto;}
  .svc-actions .btn{padding:7px 13px;font-size:12.5px;}

  .k-table{border:1px solid var(--line);border-radius:13px;overflow:hidden;background:#fff;}
  .k-cols{display:grid;grid-template-columns:1.05fr 1.7fr .85fr 1fr .95fr 108px;gap:12px;align-items:center;}
  .k-head{padding:11px 15px;background:var(--panel-soft);font-size:11.5px;font-weight:900;color:var(--muted);}
  .k-row{padding:13px 15px;font-size:12.5px;border-top:1px solid var(--line-soft);}
  .k-row code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;background:var(--panel-soft);
    border:1px solid var(--line);border-radius:7px;padding:3px 8px;}
  .k-row .nm{font-weight:900;}
  .k-row .mo{color:var(--muted);font-weight:700;}
  .k-ops{display:flex;gap:6px;justify-content:flex-end;}

  /* ============ 账号管理（用户） ============ */
  .u-table{border:1px solid var(--line);border-radius:13px;overflow:hidden;background:#fff;}
  .u-cols{display:grid;grid-template-columns:1.7fr .9fr 1.1fr 1.3fr 1.9fr;gap:12px;align-items:center;}
  .u-head{padding:12px 18px;background:linear-gradient(180deg,#f7fafe,#f1f6fd);font-size:11.5px;font-weight:900;color:var(--muted);
    border-bottom:1px solid var(--line);}
  .u-row{padding:14px 18px;font-size:13.5px;transition:.12s;}
  .u-row + .u-row{border-top:1px solid var(--line-soft);}
  .u-row:hover{background:#f9fbff;}
  .u-name{display:flex;align-items:center;gap:10px;font-weight:900;min-width:0;}
  .u-avatar{display:grid;width:34px;height:34px;place-items:center;border-radius:11px;flex:0 0 auto;
    background:linear-gradient(135deg,#eaf3ff,#dbe9ff);color:var(--accent);font-weight:900;font-size:14px;}
  .u-sub{font-size:11.5px;color:var(--muted);font-weight:700;margin-top:2px;}
  .u-muted{color:var(--muted);font-weight:700;font-size:12.5px;}
  .u-ops{display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap;}
  .u-ops .btn{padding:5px 11px;font-size:12px;}

  .qr-box{display:grid;place-items:center;gap:8px;width:170px;height:170px;margin:0 auto;
    border:1.6px dashed var(--line);border-radius:14px;background:var(--panel-soft);color:var(--muted-2);
    font-size:12px;font-weight:800;text-align:center;cursor:pointer;}
  .qr-box:hover{border-color:var(--accent);color:var(--accent-dark);background:#eef5ff;}
  .qr-box svg{width:34px;height:34px;}

  /* ============ 效果分析 ============ */
  .stats.six{grid-template-columns:repeat(3,1fr);}
  .stat .k .mut{color:var(--muted-2);font-weight:700;}

  .seg.seg-plat button{display:inline-flex;align-items:center;gap:6px;}
  .seg-plat .dot{display:inline-block;width:7px;height:7px;border-radius:50%;flex:0 0 auto;}
  .dot-site{background:#2b7cff;} .dot-xhs{background:#d9163a;}
  .dot-toutiao{background:#e33b3b;}

  .cmp-wrap{border:1px solid var(--line);border-radius:13px;overflow:hidden;background:#fff;}
  .cmp-cols{display:grid;grid-template-columns:1.6fr .95fr .95fr 1fr .85fr 1.05fr 1.15fr;gap:10px;align-items:center;}
  .cmp-head{padding:11px 16px;background:linear-gradient(180deg,#f7fafe,#f1f6fd);
    font-size:11.5px;font-weight:900;color:var(--muted);border-bottom:1px solid var(--line);}
  .cmp-head > span:not(:first-child){text-align:right;}
  .cmp-row{padding:13px 16px;font-size:13px;border-top:1px solid var(--line-soft);}
  .cmp-row:first-child{border-top:0;}
  .cmp-row:hover{background:#f9fbff;}
  .cmp-row.hl{background:#eef5ff;box-shadow:inset 3px 0 0 var(--accent);}
  .cmp-row .plat{display:flex;align-items:center;gap:9px;font-weight:900;}
  .cmp-row .plat .pd{width:9px;height:9px;border-radius:50%;flex:0 0 auto;}
  .cmp-row .m{text-align:right;font-weight:800;font-variant-numeric:tabular-nums;}
  .cmp-row .m.mut{color:var(--muted-2);font-weight:700;}
  .cmp-row.total{background:var(--panel-soft);font-weight:900;}
  .cmp-row.total:hover{background:var(--panel-soft);}
  .rate{display:inline-flex;align-items:center;gap:8px;justify-content:flex-end;
    font-weight:900;color:var(--accent-dark);font-variant-numeric:tabular-nums;}
  .rate .rb{width:46px;height:6px;border-radius:99px;background:var(--line-soft);overflow:hidden;flex:0 0 auto;}
  .rate .rb > i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--accent),var(--accent-cyan));}

  .post-wrap{border:1px solid var(--line);border-radius:13px;overflow:hidden;background:#fff;}
  .post-cols{display:grid;grid-template-columns:2.2fr .82fr 1fr 1.02fr .84fr .8fr 1.04fr 1fr 1.06fr;gap:8px;align-items:center;}
  .post-head{padding:11px 16px;background:linear-gradient(180deg,#f7fafe,#f1f6fd);
    font-size:11.5px;font-weight:900;color:var(--muted);border-bottom:1px solid var(--line);}
  .post-head > span:not(:first-child){text-align:right;}
  .post-row{padding:13px 16px;font-size:12.5px;border-top:1px solid var(--line-soft);transition:.12s;}
  .post-row:first-child{border-top:0;}
  .post-row:hover{background:#f9fbff;}
  .p-title{min-width:0;}
  .p-title .t{display:block;font-weight:800;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .p-title .s{display:flex;align-items:center;gap:6px;margin-top:5px;}
  .type-tag{font-size:10.5px;font-weight:800;padding:2px 8px;border-radius:6px;
    background:var(--panel-soft);border:1px solid var(--line);color:var(--muted);}
  .viral{font-size:10.5px;font-weight:900;padding:2px 9px;border-radius:99px;
    background:#fff1e8;color:#c2410c;border:1px solid #ffd9c2;white-space:nowrap;}
  .p-plat{display:inline-flex;align-items:center;gap:7px;font-weight:800;}
  .p-plat .pd{width:8px;height:8px;border-radius:50%;flex:0 0 auto;}
  .p-num{text-align:right;font-weight:800;font-variant-numeric:tabular-nums;}
  .p-num.mut{color:var(--muted-2);font-weight:700;}
  .p-ops{display:flex;justify-content:flex-end;}
  .p-op{padding:5px 10px;font-size:12px;white-space:nowrap;}

  /* ============ 内容拆解 ============ */
  .bk-head{display:flex;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:18px;}
  .bk-head h3{font-size:20px;font-weight:900;line-height:1.4;max-width:620px;}
  .bk-tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px;align-items:center;}
  .data-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:11px;margin-bottom:18px;}
  .ds{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px;
    box-shadow:0 4px 14px rgba(31,64,109,.05);}
  .ds .k{font-size:11px;color:var(--muted);font-weight:800;}
  .ds .v{font-size:19px;font-weight:900;margin-top:5px;font-variant-numeric:tabular-nums;}
  .bk-section{border:1px solid var(--line);border-radius:14px;padding:15px 16px;background:#fff;transition:.15s;}
  .bk-section + .bk-section{margin-top:12px;}
  .bk-section.dirty{border-color:#ffd9a8;background:#fffdf7;}
  .bk-section-head{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
  .bk-num{display:grid;width:26px;height:26px;place-items:center;border-radius:8px;flex:0 0 auto;
    background:#eaf3ff;color:var(--accent-dark);font-size:12px;font-weight:900;}
  .bk-section-head b{font-size:14px;font-weight:900;}
  .bk-section-head .hint{font-size:11.5px;color:var(--muted-2);font-weight:700;margin-left:auto;}
  .bk-edit{width:100%;min-height:74px;border:1px solid var(--line);border-radius:11px;background:var(--panel-soft);
    padding:11px 13px;font-size:13px;line-height:1.8;color:var(--ink);resize:vertical;outline:none;
    transition:.15s;font-family:inherit;}
  .bk-edit:focus{background:#fff;border-color:var(--accent);box-shadow:0 0 0 3px rgba(43,124,255,.1);}
  .dirty-dot{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:800;color:var(--warning);}
  .dirty-dot::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--warning);}

  .proto-tag{position:fixed;right:16px;bottom:16px;z-index:50;font-size:11px;font-weight:900;color:var(--muted-2);
    background:rgba(255,255,255,.8);border:1px solid var(--line);border-radius:99px;padding:6px 13px;}

  /* ---------- Embed 模式：被主应用 iframe 引入时隐藏原型自身外壳 ---------- */
  body.embed .sidebar,
  body.embed .workspace-header,
  body.embed .proto-tag{display:none !important;}
  body.embed .app-shell{grid-template-columns:1fr;}
  body.embed .workspace{padding:0;grid-template-rows:1fr;}
  body.embed .workspace-body{padding:20px 24px 32px;}
</style>
</head>
<body>

<main class="app-shell">
  <!-- ================= Sidebar ================= -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-avatar">AI</div>
      <div class="brand-text">
        <span class="brand-title">创星云</span>
        <span class="brand-sub">AI数字员工平台</span>
      </div>
    </div>

    <nav>
      <button data-sec="chat" onclick="switchSection('chat')"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span><span class="nav-label">对话</span></button>
      <button data-sec="library" onclick="switchSection('library')"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span><span class="nav-label">内容库</span></button>
      <button data-sec="analytics" onclick="switchSection('analytics')"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-7"/><path d="M17 7h3v3"/></svg></span><span class="nav-label">效果分析</span></button>
      <button class="active" data-sec="kb" onclick="switchSection('kb')"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span><span class="nav-label">知识库</span></button>
      <button data-sec="accounts" onclick="switchSection('accounts')"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5 4.5 5.4V11c0 5 3.2 8.4 7.5 10.5C16.3 19.4 19.5 16 19.5 11V5.4z"/><path d="m9.2 11.6 2 2 3.6-3.8"/></svg></span><span class="nav-label">平台授权管理</span></button>
      <button data-sec="settings" onclick="switchSection('settings')"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2.5v2.2M12 19.3v2.2M4.2 7.2l1.9 1.1M17.9 15.7l1.9 1.1M4.2 16.8l1.9-1.1M17.9 8.3l1.9-1.1"/></svg></span><span class="nav-label">系统配置</span></button>
      <button data-sec="users" onclick="switchSection('users')"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><span class="nav-label">账号管理</span></button>
      <button data-sec="profile" onclick="switchSection('profile')"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span><span class="nav-label">个人中心</span></button>
    </nav>

    <div class="sidebar-foot">
      <div class="storage-box">
        <div class="row"><span>向量存储</span><span>18.4 / 50 GB</span></div>
        <div class="bar"><i style="width:37%"></i></div>
        <div class="tip">已用切片 12,480 条</div>
      </div>
    </div>
  </aside>

  <!-- ================= Workspace ================= -->
  <section class="workspace">
    <header class="workspace-header">
      <div class="workspace-header-left">
        <span class="crumb" id="crumb">当前页面</span>
        <h2 id="pageTitle">知识库</h2>
      </div>
      <div class="user-chip">
        <span>133****8307</span>
        <button class="exit">退出</button>
      </div>
    </header>

    <div class="workspace-body">

      <!-- ---------- View: 列表 ---------- -->
      <div id="viewList">
        <div class="toolbar">
          <div class="search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
            <input placeholder="搜索知识库名称 / 描述…" />
          </div>
          <div class="seg">
            <button class="on">全部</button>
            <button>已就绪</button>
            <button>需处理</button>
          </div>
          <div class="spacer"></div>
          <button class="btn btn-ghost" onclick="openSearch()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
            检索测试
          </button>
          <button class="btn btn-primary" onclick="openKbModal()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            新建知识库
          </button>
        </div>

        <div class="stats">
          <div class="stat"><div class="k">知识库总数</div><div class="v" id="statKb">4<small>个</small></div></div>
