<div class="toast" id="toast"><span class="dot"></span><span id="toastText">已完成</span></div>
<div class="proto-tag">知识库 · 平台授权管理 · 系统配置 · 账号管理 · 交互原型</div>

<script>
  /* ---------- 数据 ---------- */
  let KB = [
    { id:1, name:"银发内容素材库", desc:"收纳银发赛道爆款笔记、竞品账号拆解与平台规则文档，供 AI 员工写作时检索引用。", ico:"alt",
      tags:["text-embedding-3-large","智能语义切片"], docs:86, chunks:3120, time:"2 小时前", status:"run", statusText:"训练中" },
    { id:2, name:"品牌与产品知识", desc:"AIMemory 产品介绍、常见问答、价格与隐私说明，保证对外口径一致。", ico:"",
      tags:["text-embedding-3-small","固定长度"], docs:32, chunks:1840, time:"昨天", status:"ok", statusText:"已就绪" },
    { id:3, name:"平台规则与合规", desc:"小红书 / 公众号发布规范、违禁词与限流案例，写作前自动检索规避。", ico:"alt2",
      tags:["bge-large-zh-v1.5","智能语义切片"], docs:24, chunks:960, time:"3 天前", status:"ok", statusText:"已就绪" },
    { id:4, name:"客户访谈与素材", desc:"真实用户访谈记录、家庭故事素材与授权说明（图片为主）。", ico:"alt",
      tags:["text-embedding-3-large","OCR 合并切分"], docs:26, chunks:0, time:"5 天前", status:"warn", statusText:"待训练" }
  ];

  const kbIco = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>`;
  const editIco = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>`;
  const delIco = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M6 6l1 14h10l1-14"/></svg>`;

  const grid = document.getElementById('kbGrid');

  function renderList(){
    grid.innerHTML = '';
    KB.forEach(k=>{
      const el = document.createElement('article');
      el.className = 'kb-card';
      el.innerHTML = `
        <div class="kb-actions">
          <button class="icon-btn" title="编辑" onclick="event.stopPropagation();openKbModal(true,'${k.name}')">${editIco}</button>
          <button class="icon-btn danger" title="删除" onclick="event.stopPropagation();askDelete('${k.name}')">${delIco}</button>
        </div>
        <div class="kb-card-top">
          <div class="kb-ico ${k.ico}">${kbIco}</div>
          <div style="min-width:0;">
            <div class="kb-name">${k.name}</div>
            <div class="kb-desc">${k.desc}</div>
          </div>
        </div>
        <div class="chips">${k.tags.map((t,i)=>`<span class="chip ${i===0?'blue':'cyan'}">${t}</span>`).join('')}</div>
        <div class="kb-foot">
          <span class="kb-meta">📄 ${k.docs} 份 · 🧩 ${k.chunks.toLocaleString()} 切片 · ${k.time}</span>
          <span class="pill ${k.status}">${k.statusText}</span>
        </div>`;
      el.onclick = () => openDetail(k);
      grid.appendChild(el);
    });
    document.getElementById('statKb').innerHTML = KB.length + '<small>个</small>';
  }
  renderList();

  /* ---------- 导航分区切换 ---------- */
  const SEC_TITLE = { chat:"对话", library:"内容库", analytics:"效果分析", kb:"知识库", accounts:"平台授权管理", settings:"系统配置", users:"账号管理", profile:"个人中心" };
  const ALL_VIEWS = ['viewList','viewDetail','viewSearch','viewAnalytics','viewBreakdown','viewAccounts','viewSettings','viewUsers','viewPlaceholder'];
  function setNav(sec){
    document.querySelectorAll('.sidebar nav button').forEach(b => b.classList.toggle('active', b.dataset.sec === sec));
  }
  function hideAllViews(){
    ALL_VIEWS.forEach(id => document.getElementById(id).classList.add('hidden'));
  }
  function switchSection(sec){
    setNav(sec);
    hideAllViews();
    document.getElementById('crumb').textContent = '当前页面';
    document.getElementById('pageTitle').textContent = SEC_TITLE[sec] || '知识库';
    if(sec === 'kb') document.getElementById('viewList').classList.remove('hidden');
    else if(sec === 'analytics'){ renderAnalytics(); document.getElementById('viewAnalytics').classList.remove('hidden'); }
    else if(sec === 'accounts') document.getElementById('viewAccounts').classList.remove('hidden');
    else if(sec === 'settings') document.getElementById('viewSettings').classList.remove('hidden');
    else if(sec === 'users') document.getElementById('viewUsers').classList.remove('hidden');
    else {
      document.getElementById('phTitle').textContent = SEC_TITLE[sec] || '模块';
      document.getElementById('viewPlaceholder').classList.remove('hidden');
    }
    document.querySelector('.workspace-body').scrollTop = 0;
  }

  /* ---------- 列表 / 详情切换 ---------- */
  function openDetail(k){
    setNav('kb');
    hideAllViews();
    document.getElementById('viewDetail').classList.remove('hidden');
    document.getElementById('crumb').textContent = '知识库 / 详情';
    document.getElementById('pageTitle').textContent = '知识库详情';
    document.getElementById('dName').textContent = k.name;
    document.getElementById('dDesc').textContent = k.desc;
    const st = document.getElementById('dStatus');
    st.className = 'pill ' + k.status;
    st.textContent = k.status==='ok' ? '已就绪' : k.status==='run' ? '训练中' : '待训练';
    goStep(1);
    document.querySelector('.workspace-body').scrollTop = 0;
  }
  function backToList(){
    setNav('kb');
    hideAllViews();
    document.getElementById('viewList').classList.remove('hidden');
    document.getElementById('crumb').textContent = '当前页面';
    document.getElementById('pageTitle').textContent = '知识库';
  }

  /* ---------- 向导步骤 ---------- */
  function goStep(n){
    [1,2,3].forEach(i=>{
      document.getElementById('step'+i).classList.toggle('hidden', i!==n);
    });
    document.querySelectorAll('.step').forEach(s=>{
      const i = +s.dataset.step;
      s.classList.toggle('active', i===n);
      s.classList.toggle('done', i<n);
      s.querySelector('.no').textContent = i<n ? '✓' : i;
    });
    document.getElementById('line1').style.width = n>1 ? '100%' : '0';
    document.getElementById('line2').style.width = n>2 ? '100%' : '0';
    document.querySelector('.workspace-body').scrollTop = 0;
  }

